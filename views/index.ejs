<!-- views/index.ejs -->
<%- include('components/header') %>
<%- include('components/navbar') %>

<main class="flex-grow">
<!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-beigeAccent/10 border border-beigeAccent/25 text-beigeAccent text-xs font-semibold mb-6">
            <i class="fa-solid fa-bolt"></i> Server-Rendered Mock Data Portal
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#35251a] via-[#634832] to-[#8c6239]">Dummy data for your</span> 
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-beigeAccent via-[#7a5839] to-[#453122]">prototypes & apps</span>
        </h1>
        <p class="max-w-2xl mx-auto text-[#453122]/80 text-lg mb-10">
            A powerful, server-rendered mock REST API built with Node.js, Express, and MongoDB. Access posts, products, users, and recipes instantly with live endpoints.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a href="/docs" class="px-6 py-3 rounded-xl bg-beigeAccent text-white font-bold hover:bg-[#4d3726] transition-all shadow-md flex items-center gap-2">
                <i class="fa-solid fa-book-open"></i> Explore Documentation
            </a>
            <a href="/about" class="px-6 py-3 rounded-xl bg-cardBurgundy text-[#35251a] font-semibold hover:bg-[#ecdccb] border border-burgundyMain/50 transition-all shadow-sm">
                Learn About Project
            </a>
        </div>
    </section>

    <!-- Cards Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Card 1 -->
            <div class="bg-cardBurgundy border border-burgundyMain/40 rounded-2xl p-6 hover:border-beigeAccent transition-all group shadow-sm">
                <div class="w-12 h-12 rounded-xl bg-beigeAccent/10 flex items-center justify-center text-beigeAccent text-xl font-bold mb-4 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-newspaper"></i>
                </div>
                <h3 class="text-xl font-bold text-[#35251a] mb-2">Posts API</h3>
                <p class="text-[#453122]/80 text-sm mb-4">Access blog articles, tags, reactions, and paginated post lists.</p>
                <a href="/api/posts" target="_blank" class="text-beigeAccent text-sm font-semibold flex items-center gap-1 hover:underline">
                    View Endpoint <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
            </div>

            <!-- Card 2 -->
            <div class="bg-cardBurgundy border border-burgundyMain/40 rounded-2xl p-6 hover:border-beigeAccent transition-all group shadow-sm">
                <div class="w-12 h-12 rounded-xl bg-beigeAccent/10 flex items-center justify-center text-beigeAccent text-xl font-bold mb-4 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-box"></i>
                </div>
                <h3 class="text-xl font-bold text-[#35251a] mb-2">Products API</h3>
                <p class="text-[#453122]/80 text-sm mb-4">Explore e-commerce mock products with prices, ratings, and categories.</p>
                <a href="/api/products" target="_blank" class="text-beigeAccent text-sm font-semibold flex items-center gap-1 hover:underline">
                    View Endpoint <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
            </div>

            <!-- Card 3 -->
            <div class="bg-cardBurgundy border border-burgundyMain/40 rounded-2xl p-6 hover:border-beigeAccent transition-all group shadow-sm">
                <div class="w-12 h-12 rounded-xl bg-beigeAccent/10 flex items-center justify-center text-beigeAccent text-xl font-bold mb-4 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-users"></i>
                </div>
                <h3 class="text-xl font-bold text-[#35251a] mb-2">Users API</h3>
                <p class="text-[#453122]/80 text-sm mb-4">Retrieve mock user profiles, contact information, and demographics.</p>
                <a href="/api/users" target="_blank" class="text-beigeAccent text-sm font-semibold flex items-center gap-1 hover:underline">
                    View Endpoint <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
            </div>

            <!-- Card 4 -->
            <div class="bg-cardBurgundy border border-burgundyMain/40 rounded-2xl p-6 hover:border-beigeAccent transition-all group shadow-sm">
                <div class="w-12 h-12 rounded-xl bg-beigeAccent/10 flex items-center justify-center text-beigeAccent text-xl font-bold mb-4 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-utensils"></i>
                </div>
                <h3 class="text-xl font-bold text-[#35251a] mb-2">Recipes API</h3>
                <p class="text-[#453122]/80 text-sm mb-4">Browse cooking recipes with ingredients, instructions, and prep times.</p>
                <a href="/api/recipes" target="_blank" class="text-beigeAccent text-sm font-semibold flex items-center gap-1 hover:underline">
                    View Endpoint <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
            </div>
        </div>
    </section>
</main>

<%- include('components/footer') %>