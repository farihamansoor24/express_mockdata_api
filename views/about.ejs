<!-- views/about.ejs -->
<%- include('components/header') %>
<%- include('components/navbar') %>

<main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full">
    <div class="space-y-12">
        <!-- Header Introduction -->
        <div class="text-center space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-beigeAccent/10 border border-beigeAccent/20 text-beigeAccent text-xs font-semibold">
                Project Overview
            </div>
            <h1 class="text-4xl font-extrabold text-white tracking-tight">About DummyJSON Clone Portal</h1>
            <p class="text-rose-100/70 text-lg max-w-2xl mx-auto">
                Designed to provide robust mock data endpoints and interactive server-rendered documentation for web developers and frontend prototypes.
            </p>
        </div>

        <!-- Architecture & Purpose -->
        <div class="bg-cardBurgundy border border-burgundyMain/50 rounded-2xl p-8 space-y-6 shadow-md">
            <h2 class="text-2xl font-bold text-white border-b border-burgundyMain/50 pb-4">Project Architecture & Purpose</h2>
            <p class="text-rose-100/80 leading-relaxed">
                This full-stack application is engineered using server-side rendering (SSR) via EJS templates combined with an Express.js REST API layer. It connects directly to MongoDB using the native driver (`MongoClient`) to store and retrieve high-performance mock datasets spanning four categories: Posts, Products, Users, and Recipes.
            </p>
        </div>

        <!-- Tech Stack Grid -->
        <div class="bg-cardBurgundy border border-burgundyMain/50 rounded-2xl p-8 space-y-6 shadow-md">
            <h2 class="text-2xl font-bold text-white border-b border-burgundyMain/50 pb-4">Technology Stack</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="flex items-start gap-4 p-4 rounded-xl bg-burgundyDark border border-burgundyMain/60">
                    <div class="w-10 h-10 rounded-lg bg-beigeAccent/10 flex items-center justify-center text-beigeAccent font-bold shrink-0">
                        <i class="fa-brands fa-node-js text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-white font-semibold">Node.js & Express.js</h3>
                        <p class="text-rose-100/70 text-sm mt-1">Backend REST API built with ES Modules (`import/export`).</p>
                    </div>
                </div>

                <div class="flex items-start gap-4 p-4 rounded-xl bg-burgundyDark border border-burgundyMain/60">
                    <div class="w-10 h-10 rounded-lg bg-beigeAccent/10 flex items-center justify-center text-beigeAccent font-bold shrink-0">
                        <i class="fa-solid fa-database text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-white font-semibold">MongoDB (MongoClient)</h3>
                        <p class="text-rose-100/70 text-sm mt-1">Direct database connection using native MongoDB driver.</p>
                    </div>
                </div>

                <div class="flex items-start gap-4 p-4 rounded-xl bg-burgundyDark border border-burgundyMain/60">
                    <div class="w-10 h-10 rounded-lg bg-beigeAccent/10 flex items-center justify-center text-beigeAccent font-bold shrink-0">
                        <i class="fa-solid fa-code text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-white font-semibold">EJS & Tailwind CSS</h3>
                        <p class="text-rose-100/70 text-sm mt-1">Server-side rendering with responsive styling via Tailwind.</p>
                    </div>
                </div>

                <div class="flex items-start gap-4 p-4 rounded-xl bg-burgundyDark border border-burgundyMain/60">
                    <div class="w-10 h-10 rounded-lg bg-beigeAccent/10 flex items-center justify-center text-beigeAccent font-bold shrink-0">
                        <i class="fa-solid fa-cloud text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-white font-semibold">Vercel Deployment</h3>
                        <p class="text-rose-100/70 text-sm mt-1">Cloud hosting for seamless production availability.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Developer Info -->
        <div class="bg-cardBurgundy border border-burgundyMain/50 rounded-2xl p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md">
            <div>
                <h3 class="text-xl font-bold text-white">Developer Information</h3>
                <p class="text-rose-100/70 text-sm mt-1">Built with precision for full-stack web development assignment requirements.</p>
            </div>
            <a href="/" class="px-6 py-3 rounded-xl bg-beigeAccent text-burgundyDark font-bold hover:bg-[#fce4d4] transition-all shadow-lg shadow-beigeAccent/10">
                Back to Home
            </a>
        </div>
    </div>
</main>

<%- include('components/footer') %>